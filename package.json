{
  "name": "projectmanagement",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src api",
    "test": "vitest run",
    "preview": "vite preview",
    "hash-password": "node scripts/hash-password.mjs",
    "setup-mfa": "node scripts/setup-mfa.mjs",
    "backup": "node scripts/backup.mjs",
    "db:migrate": "node --import ./scripts/ts-register.mjs scripts/db-migrate.ts",
    "db:import": "node --import ./scripts/ts-register.mjs scripts/db-import.ts",
    "db:redact": "node --import ./scripts/ts-register.mjs scripts/db-redact.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@upstash/qstash": "^2.13.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "typescript": "~7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "ejs": "^7.0.2",
    "glob": "^14.0.3"
  }
}
